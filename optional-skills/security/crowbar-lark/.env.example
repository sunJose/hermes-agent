# Crowbar Lark OpenAPI PoC environment.
# Copy to your local .env and fill with authorized values. Never commit real values.

LARK_BASE_URL=https://open.larksuite.com
LARK_APP_ID=cli_xxxxxxxxxxxxxxxxxxxx
LARK_APP_SECRET=replace-with-secret
LARK_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: use a pre-issued tenant token instead of app id/secret.
# LARK_TENANT_ACCESS_TOKEN=t-xxxxxxxxxxxxxxxxxxxx
