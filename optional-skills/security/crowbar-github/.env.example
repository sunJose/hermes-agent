# Crowbar GitHub OpenAPI PoC environment.
# Copy to your local .env and fill with authorized values. Never commit real values.
#
# Recommended token: fine-grained Personal Access Token scoped to the target
# repository with read-only Metadata, Contents, Issues, and Pull requests.
# For classic tokens on private repos, use the minimum read-equivalent repo
# scope accepted by your organization policy.

GITHUB_TOKEN=replace-with-personal-access-token
GITHUB_DEFAULT_OWNER=replace-with-owner
GITHUB_DEFAULT_REPO=replace-with-repo
